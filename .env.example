# MongoDB
MONGODB_URI=mongodb://mongodb:27017/doordelight
MONGODB_DB_NAME=doordelight

# JWT Authentication
JWT_SECRET=change-this-to-a-strong-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Admin Account
ADMIN_EMAIL=admin@doordelight.com
ADMIN_PASSWORD=ChangeMeAdmin123!

# Google Gemini AI (Backend Only)
GEMINI_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-2.5-flash

# Razorpay Test Mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# CORS & Client URL
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws
VITE_GOOGLE_MAPS_API_KEY=

# KYC Encryption & Road Routing
KYC_ENCRYPTION_KEY=
OSRM_BASE_URL=https://router.project-osrm.org
ORS_API_KEY=

# COD Settlement & Optional SMS Provider (Twilio)
COD_OVERDUE_DAYS=2
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
